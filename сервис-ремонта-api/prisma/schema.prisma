  order                RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer             User        @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("reviews")
}

model CraftItem {
  id                   String          @id @default(uuid()) @db.Uuid
  title                String          @db.VarChar(160)
  description          String          @db.VarChar(4000)
  priceRub             Int             @map("price_rub")
  stockQuantity        Int             @default(0) @map("stock_quantity")
  imageObjectId        String?         @map("image_object_id") @db.VarChar(255)
  imageObjectIds       String[]        @default([]) @map("image_object_ids")
  isPublished          Boolean         @default(false) @map("is_published")
  customOrderAvailable Boolean         @default(true) @map("custom_order_available")
  createdById          String?         @map("created_by_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy            User?           @relation("CraftItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders               CraftOrder[]
  shopOrderItems       ShopOrderItem[]

  @@index([isPublished, createdAt])
  @@map("craft_items")
}

model CraftOrder {
  id                   String                  @id @default(uuid()) @db.Uuid
  customerId           String                  @map("customer_id") @db.Uuid
  assignedTechnicianId String?                 @map("assigned_technician_id") @db.Uuid
  itemId               String?                 @map("item_id") @db.Uuid
  itemTitleSnapshot    String                  @map("item_title_snapshot") @db.VarChar(160)
  unitPriceRubSnapshot Int                     @map("unit_price_rub_snapshot")
  quotedPriceRub       Int?                    @map("quoted_price_rub")
  quantity             Int                     @default(1)
  note                 String                  @db.VarChar(2000)
  isCustomOrder        Boolean                 @default(false) @map("is_custom_order")
  serviceNumber        String?                 @unique @map("service_number") @db.VarChar(32)
  redeemBonuses        Boolean                 @default(false) @map("redeem_bonuses")
  bonusDiscountRub     Int                     @default(0) @map("bonus_discount_rub")
  status               CraftOrderStatus        @default(REQUESTED)
  handledById          String?                 @map("handled_by_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer             User                    @relation("CraftOrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignedTechnician   User?                   @relation("CraftOrderTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  item                 CraftItem?              @relation(fields: [itemId], references: [id], onDelete: SetNull)
  handledBy            User?                   @relation("CraftOrderHandler", fields: [handledById], references: [id], onDelete: SetNull)
  chatMessages         CraftOrderChatMessage[]
  receipt              CraftOrderReceipt?
  salaryEntry          CraftOrderSalaryEntry?
  bonusTransactions    LoyaltyTransaction[]

  @@index([customerId, createdAt])
  @@index([assignedTechnicianId, status, updatedAt])
  @@index([status, createdAt])
  @@map("craft_orders")
}

model CraftOrderReceipt {
  id               String                @id @default(uuid()) @db.Uuid
  craftOrderId     String                @unique @map("craft_order_id") @db.Uuid
  receiptNumber    String                @unique @map("receipt_number") @db.VarChar(48)
  serviceNumber    String                @map("service_number") @db.VarChar(32)
  customerName     String                @map("customer_name") @db.VarChar(120)
  customerPhone    String?               @map("customer_phone") @db.VarChar(32)
  issuedById       String?               @map("issued_by_id") @db.Uuid
  itemsSnapshot    Json                  @map("items_snapshot")
  totalRub         Int                   @map("total_rub")
  bonusDiscountRub Int                   @default(0) @map("bonus_discount_rub")
  paymentStatus    ReceiptPaymentStatus  @default(PENDING) @map("payment_status")
  paymentMethod    ReceiptPaymentMethod? @map("payment_method")
  paidAt           DateTime?             @map("paid_at") @db.Timestamptz(3)
  issuedAt         DateTime              @default(now()) @map("issued_at") @db.Timestamptz(3)
  craftOrder       CraftOrder            @relation(fields: [craftOrderId], references: [id], onDelete: Restrict)
  issuedBy         User?                 @relation("CraftReceiptIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@map("craft_order_receipts")
}

model CraftOrderSalaryEntry {
  id              String     @id @default(uuid()) @db.Uuid
  craftOrderId    String     @unique @map("craft_order_id") @db.Uuid
  technicianId    String?    @map("technician_id") @db.Uuid
  serviceTotalRub Int        @map("service_total_rub")
  salaryRub       Int        @map("salary_rub")
  ratePercent     Int        @default(75) @map("rate_percent") @db.SmallInt
  earnedAt        DateTime   @map("earned_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  craftOrder      CraftOrder @relation(fields: [craftOrderId], references: [id], onDelete: Restrict)
  technician      User?      @relation("CraftTechnicianSalaryEntries", fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([technicianId, earnedAt])
  @@index([earnedAt])
  @@map("craft_order_salary_entries")
}

model CraftOrderChatMessage {
  id            String     @id @default(uuid()) @db.Uuid
  craftOrderId  String     @map("craft_order_id") @db.Uuid
  senderId      String?    @map("sender_id") @db.Uuid
  content       String     @default("") @db.VarChar(2000)
  imageObjectId String?    @map("image_object_id") @db.VarChar(255)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  craftOrder    CraftOrder @relation(fields: [craftOrderId], references: [id], onDelete: Cascade)
  sender        User?      @relation("CraftOrderChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([craftOrderId, createdAt])
  @@index([imageObjectId])
  @@map("craft_order_chat_messages")
}

model LoyaltyTransaction {
  id              String               @id @default(uuid()) @db.Uuid
  customerId      String               @map("customer_id") @db.Uuid
  orderId         String?              @map("order_id") @db.Uuid
  craftOrderId    String?              @map("craft_order_id") @db.Uuid
  referralId      String?              @map("referral_id") @db.Uuid
  customerOfferId String?              @map("customer_offer_id") @db.Uuid
  actorId         String?              @map("actor_id") @db.Uuid
  type            BonusTransactionType
  points          Int
  reason          String               @db.VarChar(255)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  customer        User                 @relation("BonusCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  order           RepairOrder?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  craftOrder      CraftOrder?          @relation(fields: [craftOrderId], references: [id], onDelete: SetNull)
  referral        CustomerReferral?    @relation("ReferralTransactions", fields: [referralId], references: [id], onDelete: SetNull)
  customerOffer   CustomerOffer?       @relation("CustomerOfferReward", fields: [customerOfferId], references: [id], onDelete: SetNull)
  actor           User?                @relation("BonusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([referralId, customerId])
  @@unique([customerOfferId, customerId])
  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([craftOrderId])
  @@map("loyalty_transactions")
}

model CustomerReferral {
  id            String                @id @default(uuid()) @db.Uuid
  referrerId    String                @map("referrer_id") @db.Uuid
  inviteeId     String                @unique @map("invitee_id") @db.Uuid
  promoCodeId   String?               @unique @map("promo_code_id") @db.Uuid
  status        ReferralStatus        @default(PENDING)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  rewardedAt    DateTime?             @map("rewarded_at") @db.Timestamptz(3)
  rewardOrderId String?               @unique @map("reward_order_id") @db.Uuid
  referrer      User                  @relation("ReferralInviter", fields: [referrerId], references: [id], onDelete: Restrict)
  invitee       User                  @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)
  promoCode     CustomerReferralCode? @relation("ReferralPromoCodeRedemption", fields: [promoCodeId], references: [id], onDelete: SetNull)
  rewardOrder   RepairOrder?          @relation("ReferralRewardOrder", fields: [rewardOrderId], references: [id], onDelete: SetNull)
  transactions  LoyaltyTransaction[]  @relation("ReferralTransactions")

  @@index([referrerId, status, createdAt])
  @@map("customer_referrals")
}

model CustomerReferralCode {
  id        String            @id @default(uuid()) @db.Uuid
  ownerId   String            @map("owner_id") @db.Uuid
  slot      Int               @db.SmallInt
  code      String            @unique @db.VarChar(16)
  issuedAt  DateTime          @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  claimedAt DateTime?         @map("claimed_at") @db.Timestamptz(3)
  owner     User              @relation("ReferralPromoCodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  referral  CustomerReferral? @relation("ReferralPromoCodeRedemption")

  @@unique([ownerId, slot])
  @@index([ownerId, expiresAt])
  @@map("customer_referral_codes")
}

model SiteBanner {
  id            String    @id @default(uuid()) @db.Uuid
  title         String    @db.VarChar(160)
  content       String    @db.VarChar(1000)
  imageObjectId String?   @map("image_object_id") @db.VarChar(255)
  videoObjectId String?   @map("video_object_id") @db.VarChar(255)
  targetUrl     String?   @map("target_url") @db.VarChar(1000)
  placements    String[]  @default(["HOME"])
  startsAt      DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime? @map("ends_at") @db.Timestamptz(3)
  isActive      Boolean   @default(false) @map("is_active")
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     User?     @relation("BannerCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, endsAt])
  @@map("site_banners")
}

model CustomerOffer {
  id                      String                            @id @default(uuid()) @db.Uuid
  type                    CustomerOfferType
  title                   String                            @db.VarChar(160)
  content                 String                            @db.VarChar(8000)
  quizQuestion            String?                           @map("quiz_question") @db.VarChar(1000)
  quizOptions             String[]                          @default([]) @map("quiz_options")
  quizCorrectOption       Int?                              @map("quiz_correct_option") @db.SmallInt
  firstPlacePrize         String?                           @map("first_place_prize") @db.VarChar(500)
  firstPlacePrizeImageId  String?                           @map("first_place_prize_image_id") @db.VarChar(255)
  firstPlacePoints        Int                               @default(0) @map("first_place_points")
  secondPlacePrize        String?                           @map("second_place_prize") @db.VarChar(500)
  secondPlacePrizeImageId String?                           @map("second_place_prize_image_id") @db.VarChar(255)
  secondPlacePoints       Int                               @default(0) @map("second_place_points")
  thirdPlacePrize         String?                           @map("third_place_prize") @db.VarChar(500)
  thirdPlacePrizeImageId  String?                           @map("third_place_prize_image_id") @db.VarChar(255)
  thirdPlacePoints        Int                               @default(0) @map("third_place_points")
  isPublished             Boolean                           @default(false) @map("is_published")
  startsAt                DateTime                          @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime                          @map("ends_at") @db.Timestamptz(3)
  drawnAt                 DateTime?                         @map("drawn_at") @db.Timestamptz(3)
  resultsPublishedAt      DateTime?                         @map("results_published_at") @db.Timestamptz(3)
  createdById             String?                           @map("created_by_id") @db.Uuid
  createdAt               DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy               User?                             @relation("CustomerOfferCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entries                 CustomerOfferParticipation[]
  rewardTransactions      LoyaltyTransaction[]              @relation("CustomerOfferReward")
  pushDelivery            CustomerOfferPushDelivery?
  winnerPushDeliveries    CustomerOfferWinnerPushDelivery[]

  @@index([isPublished, startsAt, endsAt])
  @@index([type, endsAt])
  @@map("customer_offers")
}

model CustomerOfferPushDelivery {
  id            String        @id @default(uuid()) @db.Uuid
  offerId       String        @unique @map("offer_id") @db.Uuid
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?     @map("locked_until") @db.Timestamptz(3)
  sentAt        DateTime?     @map("sent_at") @db.Timestamptz(3)
  attemptCount  Int           @default(0) @map("attempt_count")
  lastError     String?       @map("last_error") @db.VarChar(500)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  offer         CustomerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([sentAt, nextAttemptAt, lockedUntil])
  @@map("customer_offer_push_deliveries")
}

model CustomerOfferWinnerPushDelivery {
  id            String        @id @default(uuid()) @db.Uuid
  offerId       String        @map("offer_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?     @map("locked_until") @db.Timestamptz(3)
  sentAt        DateTime?     @map("sent_at") @db.Timestamptz(3)
  attemptCount  Int           @default(0) @map("attempt_count")
  lastError     String?       @map("last_error") @db.VarChar(500)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  offer         CustomerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customer      User          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([offerId, customerId])
  @@index([sentAt, nextAttemptAt, lockedUntil])
  @@index([customerId, sentAt])
  @@map("customer_offer_winner_push_deliveries")
}

model CustomerOfferParticipation {
  id            String        @id @default(uuid()) @db.Uuid
  offerId       String        @map("offer_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  joinedAt      DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)
  place         Int?          @db.SmallInt
  answerIndex   Int?          @map("answer_index") @db.SmallInt
  answerCorrect Boolean?      @map("answer_correct")
  offer         CustomerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customer      User          @relation("CustomerOfferParticipant", fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([offerId, customerId])
  @@unique([offerId, place])
  @@index([offerId, joinedAt])
  @@index([customerId, joinedAt])
  @@map("customer_offer_participations")
}
