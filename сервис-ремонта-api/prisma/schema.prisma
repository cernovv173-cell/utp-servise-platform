generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum CustomerGender {
  MALE
  FEMALE
}

enum RepairStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum RepairOrderPriority {
  NORMAL
  URGENT
}

enum RepairOrderItemType {
  SERVICE
  SPARE_PART
  PRODUCT
}

enum RepairEstimateKind {
  INITIAL
  ADDITIONAL
}

enum RepairEstimateStatus {
  PENDING
  APPROVED
  DECLINED
  SUPERSEDED
}

enum CraftOrderStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TelegramNotificationType {
  DEVICE_ACCEPTED
  DIAGNOSIS_COMPLETED
  READY_FOR_PICKUP
}

enum TelegramDeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum MaxNotificationType {
  DEVICE_ACCEPTED
  DIAGNOSIS_COMPLETED
  READY_FOR_PICKUP
}

enum MaxDeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum BonusTransactionType {
  EARN
  REDEEM
  MANUAL_ADJUSTMENT
}

enum ReceiptPaymentStatus {
  PENDING
  PAID
}

enum ReceiptPaymentMethod {
  CASH
  CARD_TERMINAL
  BANK_TRANSFER
  OTHER
}

model AppSetting {
  key       String   @id
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  value     Json

  @@map("app_settings")
}

model User {
  id                      String                         @id @default(uuid()) @db.Uuid
  email                   String                         @unique @db.VarChar(320)
  displayName             String                         @map("display_name") @db.VarChar(120)
  phoneNumber             String?                        @map("phone_number") @db.VarChar(32)
  gender                  CustomerGender?
  birthDate               DateTime?                      @map("birth_date") @db.Date
  avatarObjectId          String?                        @map("avatar_object_id") @db.VarChar(255)
  passwordHash            String                         @map("password_hash") @db.VarChar(255)
  yandexId                String?                        @unique @map("yandex_id") @db.VarChar(128)
  vkId                    String?                        @unique @map("vk_id") @db.VarChar(128)
  telegramChatId          String?                        @unique @map("telegram_chat_id") @db.VarChar(64)
  maxUserId               String?                        @unique @map("max_user_id") @db.VarChar(64)
  role                    UserRole                       @default(CUSTOMER)
  salaryRatePercent       Int                            @default(75) @map("salary_rate_percent") @db.SmallInt
  active                  Boolean                        @default(true)
  mustChangePassword      Boolean                        @default(false) @map("must_change_password")
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  customerOrders          RepairOrder[]                  @relation("CustomerOrders")
  assignedOrders          RepairOrder[]                  @relation("AssignedOrders")
  statusChanges           RepairStatusEvent[]            @relation("StatusActor")
  createdRepairEstimates  RepairEstimate[]               @relation("RepairEstimateCreator")
  repairDeadlineChanges   RepairOrderDeadlineChange[]    @relation("RepairDeadlineChangeActor")
  reviews                 Review[]
  addedOrderItems         RepairOrderItem[]              @relation("OrderItemAdder")
  catalogItemsCreated     RepairCatalogItem[]            @relation("CatalogItemCreator")
  newsArticlesCreated     NewsArticle[]                  @relation("NewsArticleCreator")
  orderChatMessages       OrderChatMessage[]             @relation("OrderChatMessageSender")
  craftOrderChatMessages  CraftOrderChatMessage[]        @relation("CraftOrderChatMessageSender")
  requestedChats          OrderChat[]                    @relation("ChatEscalationRequester")
  joinedChats             OrderChat[]                    @relation("ChatAdministratorJoiner")
  repairChatReadReceipts  OrderChatAdminRead[]           @relation("RepairChatReadAdministrator")
  pushDeviceTokens        PushDeviceToken[]
  orderPhotos             RepairOrderPhoto[]
  createdIntakes          RepairOrderIntake[]            @relation("IntakeCreator")
  updatedIntakes          RepairOrderIntake[]            @relation("IntakeUpdater")
  issuedRepairWarranties  RepairWarranty[]               @relation("WarrantyIssuer")
  craftItemsCreated       CraftItem[]                    @relation("CraftItemCreator")
  craftOrders             CraftOrder[]                   @relation("CraftOrderCustomer")
  handledCraftOrders      CraftOrder[]                   @relation("CraftOrderHandler")
  assignedCraftOrders     CraftOrder[]                   @relation("CraftOrderTechnician")
  craftSalaryEntries      CraftOrderSalaryEntry[]        @relation("CraftTechnicianSalaryEntries")
  bonusTransactions       LoyaltyTransaction[]           @relation("BonusCustomer")
  bonusActions            LoyaltyTransaction[]           @relation("BonusActor")
  createdBanners          SiteBanner[]                   @relation("BannerCreator")
  issuedReceipts          RepairReceipt[]                @relation("ReceiptIssuer")
  issuedCraftReceipts     CraftOrderReceipt[]            @relation("CraftReceiptIssuer")
  technicianSalaryEntries TechnicianSalaryEntry[]        @relation("TechnicianSalaryEntries")
  supportConversations    SupportConversation[]          @relation("SupportConversationCustomer")
  supportMessages         SupportChatMessage[]           @relation("SupportChatMessageSender")
  birthdayPushDeliveries  BirthdayPushDelivery[]
  customerDevices         CustomerDevice[]
  telegramLinkTokens      TelegramLinkToken[]
  telegramNotifications   TelegramNotificationDelivery[]
  maxLinkTokens           MaxLinkToken[]
  maxNotifications        MaxNotificationDelivery[]

  @@index([role, active])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model PushDeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(4096)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_device_tokens")
}

model BirthdayPushDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  birthdayYear  Int       @map("birthday_year")
  attemptCount  Int       @default(0) @map("attempt_count")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, birthdayYear])
  @@index([birthdayYear, sentAt, nextAttemptAt, lockedUntil])
  @@map("birthday_push_deliveries")
}

model RepairOrder {
  id                    String                         @id @default(uuid()) @db.Uuid
  serviceNumber         String                         @unique @map("service_number") @db.VarChar(32)
  customerId            String                         @map("customer_id") @db.Uuid
  customerDeviceId      String?                        @map("customer_device_id") @db.Uuid
  warrantyOriginOrderId String?                        @map("warranty_origin_order_id") @db.Uuid
  assignedTechnicianId  String?                        @map("assigned_technician_id") @db.Uuid
  deviceType            String                         @map("device_type") @db.VarChar(120)
  deviceBrand           String?                        @map("device_brand") @db.VarChar(120)
  deviceModel           String?                        @map("device_model") @db.VarChar(160)
  deviceSerialNumber    String?                        @map("device_serial_number") @db.VarChar(160)
  problem               String                         @db.VarChar(2000)
  address               String                         @db.VarChar(500)
  contactPhone          String?                        @map("contact_phone") @db.VarChar(32)
  city                  String?                        @db.VarChar(120)
  street                String?                        @db.VarChar(180)
  house                 String?                        @db.VarChar(30)
  apartment             String?                        @db.VarChar(30)
  entrance              String?                        @db.VarChar(30)
  hasBarrier            Boolean                        @default(false) @map("has_barrier")
  floor                 String?                        @db.VarChar(20)
  additionalPhone       String?                        @map("additional_phone") @db.VarChar(32)
  additionalInfo        String?                        @map("additional_info") @db.VarChar(500)
  preferredAt           DateTime?                      @map("preferred_at") @db.Timestamptz(3)
  expectedCompletionAt  DateTime?                      @map("expected_completion_at") @db.Timestamptz(3)
  redeemBonuses         Boolean                        @default(false) @map("redeem_bonuses")
  bonusDiscountRub      Int                            @default(0) @map("bonus_discount_rub")
  status                RepairStatus                   @default(REQUESTED)
  priority              RepairOrderPriority            @default(NORMAL)
  diagnosisCompletedAt  DateTime?                      @map("diagnosis_completed_at") @db.Timestamptz(3)
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt            DateTime?                      @map("archived_at") @db.Timestamptz(3)
  customer              User                           @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  customerDevice        CustomerDevice?                @relation(fields: [customerDeviceId], references: [id], onDelete: SetNull)
  warrantyOriginOrder   RepairOrder?                   @relation("WarrantyClaims", fields: [warrantyOriginOrderId], references: [id], onDelete: SetNull)
  warrantyClaims        RepairOrder[]                  @relation("WarrantyClaims")
  assignedTechnician    User?                          @relation("AssignedOrders", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  statusEvents          RepairStatusEvent[]
  items                 RepairOrderItem[]
  estimates             RepairEstimate[]
  deadlineChanges       RepairOrderDeadlineChange[]
  photos                RepairOrderPhoto[]
  intake                RepairOrderIntake?
  pickupCode            RepairOrderPickupCode?
  warranty              RepairWarranty?
  chat                  OrderChat?
  review                Review?
  bonusTransactions     LoyaltyTransaction[]
  receipt               RepairReceipt?
  salaryEntry           TechnicianSalaryEntry?
  telegramNotifications TelegramNotificationDelivery[]
  maxNotifications      MaxNotificationDelivery[]

  @@index([customerId, createdAt])
  @@index([assignedTechnicianId, status, updatedAt])
  @@index([status, createdAt])
  @@index([preferredAt, status])
  @@index([status, expectedCompletionAt])
  @@index([customerDeviceId])
  @@index([warrantyOriginOrderId])
  @@index([archivedAt, createdAt])
  @@map("repair_orders")
}

model CustomerDevice {
  id                 String                              @id @default(uuid()) @db.Uuid
  customerId         String                              @map("customer_id") @db.Uuid
  deviceType         String                              @map("device_type") @db.VarChar(120)
  nickname           String?                             @db.VarChar(120)
  brand              String?                             @db.VarChar(120)
  model              String?                             @db.VarChar(160)
  serialNumber       String?                             @map("serial_number") @db.VarChar(160)
  nextMaintenanceAt  DateTime?                           @map("next_maintenance_at") @db.Date
  maintenanceNote    String?                             @map("maintenance_note") @db.VarChar(250)
  createdAt          DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer           User                                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  repairOrders       RepairOrder[]
  reminderDeliveries DeviceMaintenanceReminderDelivery[]

  @@index([customerId, createdAt])
  @@map("customer_devices")
}

model DeviceMaintenanceReminderDelivery {
  id            String         @id @default(uuid()) @db.Uuid
  deviceId      String         @map("device_id") @db.Uuid
  scheduledFor  DateTime       @map("scheduled_for") @db.Date
  attemptCount  Int            @default(0) @map("attempt_count")
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?      @map("locked_until") @db.Timestamptz(3)
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz(3)
  lastError     String?        @map("last_error") @db.VarChar(500)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  device        CustomerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, scheduledFor])
  @@index([sentAt, nextAttemptAt, lockedUntil])
  @@map("device_maintenance_reminder_deliveries")
}

model RepairOrderItem {
  id            String              @id @default(uuid()) @db.Uuid
  orderId       String              @map("order_id") @db.Uuid
  catalogItemId String?             @map("catalog_item_id") @db.Uuid
  type          RepairOrderItemType
  name          String              @db.VarChar(160)
  quantity      Int                 @default(1)
  unitPriceRub  Int                 @map("unit_price_rub")
  addedById     String?             @map("added_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  order         RepairOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem   RepairCatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  addedBy       User?               @relation("OrderItemAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([catalogItemId])
  @@map("repair_order_items")
}

model RepairEstimate {
  id                   String               @id @default(uuid()) @db.Uuid
  orderId              String               @map("order_id") @db.Uuid
  createdById          String?              @map("created_by_id") @db.Uuid
  version              Int
  kind                 RepairEstimateKind
  status               RepairEstimateStatus @default(PENDING)
  diagnosis            String               @db.VarChar(2000)
  itemsSnapshot        Json                 @map("items_snapshot")
  totalRub             Int                  @map("total_rub")
  customerResponseNote String?              @map("customer_response_note") @db.VarChar(500)
  submittedAt          DateTime             @default(now()) @map("submitted_at") @db.Timestamptz(3)
  respondedAt          DateTime?            @map("responded_at") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  order                RepairOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy            User?                @relation("RepairEstimateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([orderId, version])
  @@index([orderId, status, version])
  @@map("repair_estimates")
}

model RepairOrderDeadlineChange {
  id                   String      @id @default(uuid()) @db.Uuid
  orderId              String      @map("order_id") @db.Uuid
  actorId              String?     @map("actor_id") @db.Uuid
  previousExpectedAt   DateTime?   @map("previous_expected_at") @db.Timestamptz(3)
  expectedCompletionAt DateTime?   @map("expected_completion_at") @db.Timestamptz(3)
  note                 String?     @db.VarChar(500)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  order                RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor                User?       @relation("RepairDeadlineChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("repair_order_deadline_changes")
}

model TechnicianSalaryEntry {
  id              String      @id @default(uuid()) @db.Uuid
  orderId         String      @unique @map("order_id") @db.Uuid
  technicianId    String?     @map("technician_id") @db.Uuid
  serviceTotalRub Int         @map("service_total_rub")
  salaryRub       Int         @map("salary_rub")
  ratePercent     Int         @default(75) @map("rate_percent") @db.SmallInt
  earnedAt        DateTime    @map("earned_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  order           RepairOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  technician      User?       @relation("TechnicianSalaryEntries", fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([technicianId, earnedAt])
  @@index([earnedAt])
  @@map("technician_salary_entries")
}

model RepairOrderPhoto {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  objectId    String      @unique @map("object_id") @db.VarChar(255)
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  order       RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("repair_order_photos")
}

model RepairOrderIntake {
  id                  String      @id @default(uuid()) @db.Uuid
  orderId             String      @unique @map("order_id") @db.Uuid
  frontCondition      String      @default("") @map("front_condition") @db.VarChar(1000)
  frontPhotoObjectId  String?     @map("front_photo_object_id") @db.VarChar(255)
  backCondition       String      @default("") @map("back_condition") @db.VarChar(1000)
  backPhotoObjectId   String?     @map("back_photo_object_id") @db.VarChar(255)
  leftCondition       String      @default("") @map("left_condition") @db.VarChar(1000)
  leftPhotoObjectId   String?     @map("left_photo_object_id") @db.VarChar(255)
  rightCondition      String      @default("") @map("right_condition") @db.VarChar(1000)
  rightPhotoObjectId  String?     @map("right_photo_object_id") @db.VarChar(255)
  serialNumber        String?     @map("serial_number") @db.VarChar(160)
  includedAccessories String      @default("") @map("included_accessories") @db.VarChar(1000)
  intakeNotes         String      @default("") @map("intake_notes") @db.VarChar(2000)
  createdById         String?     @map("created_by_id") @db.Uuid
  updatedById         String?     @map("updated_by_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  order               RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy           User?       @relation("IntakeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?       @relation("IntakeUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("repair_order_intakes")
}

model RepairOrderPickupCode {
  id                   String      @id @default(uuid()) @db.Uuid
  orderId              String      @unique @map("order_id") @db.Uuid
  tokenHash            String      @unique @map("token_hash") @db.Char(64)
  fallbackCodeHash     String?     @map("fallback_code_hash") @db.Char(64)
  fallbackCodeSalt     String?     @map("fallback_code_salt") @db.Char(32)
  fallbackCodeAttempts Int         @default(0) @map("fallback_code_attempts")
  expiresAt            DateTime    @map("expires_at") @db.Timestamptz(3)
  usedAt               DateTime?   @map("used_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([expiresAt, usedAt])
  @@map("repair_order_pickup_codes")
}

model RepairWarranty {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @unique @map("order_id") @db.Uuid
  warrantyNumber String      @unique @map("warranty_number") @db.VarChar(48)
  customerName   String      @map("customer_name") @db.VarChar(120)
  deviceType     String      @map("device_type") @db.VarChar(120)
  repairSummary  String      @map("repair_summary") @db.VarChar(2000)
  warrantyDays   Int         @map("warranty_days") @db.Integer
  terms          String      @db.VarChar(3000)
  issuedAt       DateTime    @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(3)
  issuedById     String?     @map("issued_by_id") @db.Uuid
  order          RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issuedBy       User?       @relation("WarrantyIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@map("repair_warranties")
}

model RepairReceipt {
  id               String                @id @default(uuid()) @db.Uuid
  orderId          String                @unique @map("order_id") @db.Uuid
  receiptNumber    String                @unique @map("receipt_number") @db.VarChar(48)
  serviceNumber    String                @map("service_number") @db.VarChar(32)
  customerName     String                @map("customer_name") @db.VarChar(120)
  customerPhone    String?               @map("customer_phone") @db.VarChar(32)
  issuedById       String?               @map("issued_by_id") @db.Uuid
  itemsSnapshot    Json                  @map("items_snapshot")
  totalRub         Int                   @map("total_rub")
  bonusDiscountRub Int                   @default(0) @map("bonus_discount_rub")
  paymentStatus    ReceiptPaymentStatus  @default(PENDING) @map("payment_status")
  paymentMethod    ReceiptPaymentMethod? @map("payment_method")
  paidAt           DateTime?             @map("paid_at") @db.Timestamptz(3)
  issuedAt         DateTime              @default(now()) @map("issued_at") @db.Timestamptz(3)
  order            RepairOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issuedBy         User?                 @relation("ReceiptIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@map("repair_receipts")
}

model RepairCatalogItem {
  id                   String              @id @default(uuid()) @db.Uuid
  type                 RepairOrderItemType
  name                 String              @db.VarChar(160)
  unitPriceRub         Int                 @map("unit_price_rub")
  stockQuantity        Int?                @map("stock_quantity")
  minimumStockQuantity Int?                @map("minimum_stock_quantity")
  active               Boolean             @default(true)
  createdById          String?             @map("created_by_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy            User?               @relation("CatalogItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orderItems           RepairOrderItem[]

  @@index([active, type, name])
  @@map("repair_catalog_items")
}

model NewsArticle {
  id            String            @id @default(uuid()) @db.Uuid
  title         String            @db.VarChar(160)
  content       String            @db.VarChar(8000)
  imageObjectId String?           @map("image_object_id") @db.VarChar(255)
  isPublished   Boolean           @default(false) @map("is_published")
  startsAt      DateTime?         @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime?         @map("ends_at") @db.Timestamptz(3)
  isFeatured    Boolean           @default(false) @map("is_featured")
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(3)
  createdById   String?           @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
